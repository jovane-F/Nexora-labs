generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// La table `roles` du dump SQL n'est reliée par aucune clé étrangère à `users`
// (users.role est un enum autonome) — elle n'est donc pas mappée ici.

enum UserRole {
  ADMIN
  CLIENT
  STUDENT
  INSTRUCTOR
}

model User {
  id           BigInt   @id @default(autoincrement())
  role         UserRole @default(CLIENT)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  instructor     Instructor?
  enrollments    Enrollment[]
  payments       Payment[]
  quoteRequests  QuoteRequest[]
  projects       Project[]           @relation("ClientProjects")
  tickets        Ticket[]
  ticketMessages TicketMessage[]
  submissions    StudentSubmission[]

  @@map("users")
}

model Pack {
  id               Int      @id @default(autoincrement())
  title            String   @db.VarChar(150)
  slug             String   @unique @db.VarChar(150)
  shortDescription String?  @map("short_description") @db.Text
  fullProgram      String   @map("full_program") @db.Text
  prerequisites    String?  @db.Text
  priceFull        Decimal  @map("price_full") @db.Decimal(12, 2)
  priceInstallment Decimal? @map("price_installment") @db.Decimal(12, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  sessions AcademySession[]
  courses  Course[]

  @@map("packs")
}

model AcademySession {
  id                  Int      @id @default(autoincrement())
  packId              Int      @map("pack_id")
  title                String   @db.VarChar(150)
  startDate           DateTime @map("start_date") @db.Date
  endDate             DateTime @map("end_date") @db.Date
  liveScheduleInfo    String   @map("live_schedule_info") @db.VarChar(255)
  communityGroupLink  String?  @map("community_group_link") @db.VarChar(255)
  isOpenForEnrollment Boolean  @default(true) @map("is_open_for_enrollment")
  createdAt           DateTime @default(now()) @map("created_at")

  pack        Pack                 @relation(fields: [packId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  enrollments Enrollment[]
  instructors SessionInstructor[]

  @@map("academy_sessions")
}

model Course {
  id          Int      @id @default(autoincrement())
  packId      Int      @map("pack_id")
  title       String   @db.VarChar(150)
  description String?  @db.Text
  orderIndex  Int      @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")

  pack      Pack             @relation(fields: [packId], references: [id], onDelete: Cascade)
  resources CourseResource[]

  @@map("courses")
}

enum ResourceType {
  VIDEO
  PDF
  LINK
  REPLAY_LIVE
}

model CourseResource {
  id        Int          @id @default(autoincrement())
  courseId  Int          @map("course_id")
  title     String       @db.VarChar(150)
  type      ResourceType
  url       String       @db.VarChar(255)
  createdAt DateTime     @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_resources")
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

model Enrollment {
  id             BigInt           @id @default(autoincrement())
  studentId      BigInt           @map("student_id")
  sessionId      Int              @map("session_id")
  status         EnrollmentStatus @default(ACTIVE)
  enrollmentDate DateTime         @default(now()) @map("enrollment_date")

  student  User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session  AcademySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([studentId, sessionId], name: "unique_student_session")
  @@map("enrollments")
}

model Instructor {
  id        Int     @id @default(autoincrement())
  userId    BigInt  @unique @map("user_id")
  bio       String? @db.Text
  specialty String  @db.VarChar(150)

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions SessionInstructor[]

  @@map("instructors")
}

model SessionInstructor {
  sessionId    Int @map("session_id")
  instructorId Int @map("instructor_id")

  session    AcademySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  instructor Instructor     @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([sessionId, instructorId])
  @@map("session_instructors")
}

model Assignment {
  id           Int      @id @default(autoincrement())
  sessionId    Int      @map("session_id")
  title        String   @db.VarChar(150)
  instructions String   @db.Text
  dueDate      DateTime @map("due_date")
  createdAt    DateTime @default(now()) @map("created_at")

  session     AcademySession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submissions StudentSubmission[]

  @@map("assignments")
}

model StudentSubmission {
  id            BigInt   @id @default(autoincrement())
  assignmentId  Int      @map("assignment_id")
  studentId     BigInt   @map("student_id")
  submissionUrl String   @map("submission_url") @db.VarChar(255)
  grade         String?  @db.VarChar(10)
  feedback      String?  @db.Text
  submittedAt   DateTime @default(now()) @map("submitted_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId], name: "unique_submission")
  @@map("student_submissions")
}

enum ServiceCategory {
  DEV_WEB_MOBILE
  MAINTENANCE
  COMMUNITY_MANAGEMENT
  BRANDING
}

model Service {
  id               Int             @id @default(autoincrement())
  title            String          @db.VarChar(150)
  slug             String          @unique @db.VarChar(150)
  category         ServiceCategory
  shortDescription String?         @map("short_description") @db.Text
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")

  quoteRequests QuoteRequest[]

  @@map("services")
}

enum QuoteStatus {
  PENDING
  CALL_SCHEDULED
  APPROVED
  REJECTED
}

model QuoteRequest {
  id                 BigInt      @id @default(autoincrement())
  userId             BigInt?     @map("user_id")
  serviceId          Int?        @map("service_id")
  projectType        String      @map("project_type") @db.VarChar(100)
  estimatedBudget    String      @map("estimated_budget") @db.VarChar(50)
  estimatedTimeline  String      @map("estimated_timeline") @db.VarChar(50)
  projectDescription String      @map("project_description") @db.Text
  formAnswers        Json?       @map("form_answers")
  status             QuoteStatus @default(PENDING)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  user     User?     @relation(fields: [userId], references: [id])
  service  Service?  @relation(fields: [serviceId], references: [id])
  project  Project?
  payments Payment[]

  @@map("quote_requests")
}

enum ProjectStatus {
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

model Project {
  id               BigInt        @id @default(autoincrement())
  quoteRequestId   BigInt?       @unique @map("quote_request_id")
  clientId         BigInt        @map("client_id")
  title            String        @db.VarChar(200)
  status           ProjectStatus @default(IN_PROGRESS)
  startDate        DateTime?     @map("start_date") @db.Date
  estimatedEndDate DateTime?     @map("estimated_end_date") @db.Date
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  quoteRequest QuoteRequest? @relation(fields: [quoteRequestId], references: [id])
  client       User          @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  tickets      Ticket[]

  @@map("projects")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id        BigInt         @id @default(autoincrement())
  projectId BigInt         @map("project_id")
  clientId  BigInt         @map("client_id")
  subject   String         @db.VarChar(200)
  priority  TicketPriority @default(MEDIUM)
  status    TicketStatus   @default(OPEN)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client   User            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@map("tickets")
}

model TicketMessage {
  id          BigInt   @id @default(autoincrement())
  ticketId    BigInt   @map("ticket_id")
  senderId    BigInt   @map("sender_id")
  message     String   @db.Text
  attachments Json?
  createdAt   DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
}

enum PaymentType {
  FULL
  INSTALLMENT_1
  INSTALLMENT_2
  SERVICE_DEPOSIT
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

model Payment {
  id                   BigInt        @id @default(autoincrement())
  userId               BigInt        @map("user_id")
  enrollmentId         BigInt?       @map("enrollment_id")
  quoteRequestId       BigInt?       @map("quote_request_id")
  amount               Decimal       @db.Decimal(12, 2)
  method               PaymentMethod
  type                 PaymentType
  status               PaymentStatus @default(PENDING)
  transactionReference String        @unique @map("transaction_reference") @db.VarChar(100)
  paymentDetails       Json?         @map("payment_details")
  createdAt            DateTime      @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id])
  quoteRequest QuoteRequest? @relation(fields: [quoteRequestId], references: [id])

  @@map("payments")
}

enum PortfolioCategory {
  DEV_WEB
  DEV_MOBILE
  BRANDING
  ACADEMY_PROJECT
}

model PortfolioItem {
  id            Int               @id @default(autoincrement())
  title         String            @db.VarChar(150)
  slug          String            @unique @db.VarChar(150)
  category      PortfolioCategory
  clientName    String?           @map("client_name") @db.VarChar(100)
  summary       String            @db.Text
  caseStudy     String?           @map("case_study") @db.Text
  coverImageUrl String            @map("cover_image_url") @db.VarChar(255)
  projectUrl    String?           @map("project_url") @db.VarChar(255)
  isFeatured    Boolean           @default(false) @map("is_featured")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@map("portfolio_items")
}
