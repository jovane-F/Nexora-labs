generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             BigInt              @id @default(autoincrement())
  role           user_role           @default(CLIENT)
  firstName      String              @map("first_name") @db.VarChar(100)
  lastName       String              @map("last_name") @db.VarChar(100)
  email          String              @unique @db.VarChar(255)
  phone          String?             @db.VarChar(30)
  passwordHash   String              @map("password_hash") @db.VarChar(255)
  isActive       Boolean?            @default(true) @map("is_active")
  createdAt      DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chat_messages  chat_messages[]
  enrollments    Enrollment[]
  instructor     Instructor?
  payments       Payment[]
  projects       Project[]           @relation("ClientProjects")
  quoteRequests  QuoteRequest[]
  submissions    StudentSubmission[]
  ticketMessages TicketMessage[]
  tickets        Ticket[]

  @@index([email], map: "idx_users_email")
  @@map("users")
}

model Pack {
  id               Int              @id @default(autoincrement())
  title            String           @db.VarChar(150)
  slug             String           @unique @db.VarChar(150)
  shortDescription String?          @map("short_description")
  fullProgram      String           @map("full_program")
  prerequisites    String?
  priceFull        Decimal          @map("price_full") @db.Decimal(12, 2)
  priceInstallment Decimal?         @map("price_installment") @db.Decimal(12, 2)
  isActive         Boolean?         @default(true) @map("is_active")
  createdAt        DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions         AcademySession[]
  courses          Course[]

  @@map("packs")
}

model AcademySession {
  id                  Int                 @id @default(autoincrement())
  packId              Int                 @map("pack_id")
  title               String              @db.VarChar(150)
  startDate           DateTime            @map("start_date") @db.Date
  endDate             DateTime            @map("end_date") @db.Date
  liveScheduleInfo    String              @map("live_schedule_info") @db.VarChar(255)
  communityGroupLink  String?             @map("community_group_link") @db.VarChar(255)
  isOpenForEnrollment Boolean?            @default(true) @map("is_open_for_enrollment")
  createdAt           DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  pack                Pack                @relation(fields: [packId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignments         Assignment[]
  chat_rooms          chat_rooms[]
  enrollments         Enrollment[]
  instructors         SessionInstructor[]

  @@map("academy_sessions")
}

model Course {
  id          Int              @id @default(autoincrement())
  packId      Int              @map("pack_id")
  title       String           @db.VarChar(150)
  description String?
  orderIndex  Int              @map("order_index")
  createdAt   DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  resources   CourseResource[]
  pack        Pack             @relation(fields: [packId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("courses")
}

model CourseResource {
  id            Int           @id @default(autoincrement())
  courseId      Int           @map("course_id")
  instructor_id Int?
  title         String        @db.VarChar(150)
  type          resource_type
  url           String        @db.VarChar(255)
  createdAt     DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  instructors   Instructor?   @relation(fields: [instructor_id], references: [id], onUpdate: NoAction)

  @@map("course_resources")
}

model Enrollment {
  id             BigInt             @id @default(autoincrement())
  studentId      BigInt             @map("student_id")
  sessionId      Int                @map("session_id")
  status         enrollment_status? @default(ACTIVE)
  enrollmentDate DateTime?          @default(now()) @map("enrollment_date") @db.Timestamptz(6)
  session        AcademySession     @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student        User               @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments       Payment[]

  @@unique([studentId, sessionId], name: "unique_student_session", map: "unique_student_session")
  @@index([studentId], map: "idx_enrollments_student")
  @@map("enrollments")
}

model Instructor {
  id                       Int                 @id @default(autoincrement())
  userId                   BigInt              @unique @map("user_id")
  bio                      String?
  specialty                String              @db.VarChar(150)
  monthly_call_quota_hours Int?                @default(40)
  audio_calls              audio_calls[]
  course_resources         CourseResource[]
  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sessions                 SessionInstructor[]

  @@map("instructors")
}

model SessionInstructor {
  sessionId    Int            @map("session_id")
  instructorId Int            @map("instructor_id")
  instructor   Instructor     @relation(fields: [instructorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session      AcademySession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([sessionId, instructorId])
  @@map("session_instructors")
}

model Assignment {
  id           Int                 @id @default(autoincrement())
  sessionId    Int                 @map("session_id")
  title        String              @db.VarChar(150)
  instructions String
  dueDate      DateTime            @map("due_date") @db.Timestamptz(6)
  createdAt    DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  session      AcademySession      @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submissions  StudentSubmission[]

  @@map("assignments")
}

model StudentSubmission {
  id            BigInt     @id @default(autoincrement())
  assignmentId  Int        @map("assignment_id")
  studentId     BigInt     @map("student_id")
  submissionUrl String     @map("submission_url") @db.VarChar(255)
  grade         String?    @db.VarChar(10)
  feedback      String?
  submittedAt   DateTime?  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student       User       @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assignmentId, studentId], name: "unique_submission", map: "unique_submission")
  @@map("student_submissions")
}

model Service {
  id               Int              @id @default(autoincrement())
  title            String           @db.VarChar(150)
  slug             String           @unique @db.VarChar(150)
  category         service_category
  shortDescription String?          @map("short_description")
  isActive         Boolean?         @default(true) @map("is_active")
  createdAt        DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  quoteRequests    QuoteRequest[]

  @@map("services")
}

model QuoteRequest {
  id                          BigInt            @id @default(autoincrement())
  userId                      BigInt?           @map("user_id")
  serviceId                   Int?              @map("service_id")
  defense_project_id          Int?
  company_name                String?           @db.VarChar(150)
  project_name                String            @db.VarChar(150)
  projectType                 String            @map("project_type") @db.VarChar(100)
  estimatedBudget             String?           @map("estimated_budget") @db.VarChar(50)
  estimatedTimeline           String?           @map("estimated_timeline") @db.VarChar(50)
  projectDescription          String            @map("project_description")
  spec_sheet_url              String?           @db.VarChar(255)
  is_free_evaluation_eligible Boolean?          @default(true)
  evaluation_expires_at       DateTime?         @default(dbgenerated("(CURRENT_TIMESTAMP + '6 mons'::interval)")) @db.Timestamptz(6)
  formAnswers                 Json?             @map("form_answers")
  status                      quote_status?     @default(PENDING)
  createdAt                   DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime?         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  payments                    Payment[]
  project                     Project?
  defense_projects            defense_projects? @relation(fields: [defense_project_id], references: [id], onUpdate: NoAction)
  service                     Service?          @relation(fields: [serviceId], references: [id], onUpdate: NoAction)
  user                        User?             @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([userId], map: "idx_quote_requests_user")
  @@map("quote_requests")
}

model Project {
  id               BigInt          @id @default(autoincrement())
  quoteRequestId   BigInt?         @unique @map("quote_request_id")
  clientId         BigInt          @map("client_id")
  title            String          @db.VarChar(200)
  status           project_status? @default(IN_PROGRESS)
  startDate        DateTime?       @map("start_date") @db.Date
  estimatedEndDate DateTime?       @map("estimated_end_date") @db.Date
  createdAt        DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chat_rooms       chat_rooms[]
  client           User            @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quoteRequest     QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onUpdate: NoAction)
  tickets          Ticket[]

  @@index([clientId], map: "idx_projects_client")
  @@map("projects")
}

model Ticket {
  id        BigInt           @id @default(autoincrement())
  projectId BigInt           @map("project_id")
  clientId  BigInt           @map("client_id")
  subject   String           @db.VarChar(200)
  priority  ticket_priority? @default(MEDIUM)
  status    ticket_status?   @default(OPEN)
  createdAt DateTime?        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime?        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  messages  TicketMessage[]
  client    User             @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([projectId], map: "idx_tickets_project")
  @@map("tickets")
}

model TicketMessage {
  id          BigInt    @id @default(autoincrement())
  ticketId    BigInt    @map("ticket_id")
  senderId    BigInt    @map("sender_id")
  message     String
  attachments Json?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("ticket_messages")
}

model Payment {
  id                   BigInt          @id @default(autoincrement())
  userId               BigInt          @map("user_id")
  enrollmentId         BigInt?         @map("enrollment_id")
  quoteRequestId       BigInt?         @map("quote_request_id")
  amount               Decimal         @db.Decimal(12, 2)
  method               payment_method
  type                 payment_type
  status               payment_status? @default(PENDING)
  transactionReference String          @unique @map("transaction_reference") @db.VarChar(100)
  qr_code_url          String?         @db.VarChar(255)
  paymentDetails       Json?           @map("payment_details")
  createdAt            DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  enrollment           Enrollment?     @relation(fields: [enrollmentId], references: [id], onUpdate: NoAction)
  quoteRequest         QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onUpdate: NoAction)
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([transactionReference], map: "idx_payments_ref")
  @@map("payments")
}

model PortfolioItem {
  id            Int                @id @default(autoincrement())
  title         String             @db.VarChar(150)
  slug          String             @unique @db.VarChar(150)
  category      portfolio_category
  clientName    String?            @map("client_name") @db.VarChar(100)
  summary       String
  caseStudy     String?            @map("case_study")
  coverImageUrl String             @map("cover_image_url") @db.VarChar(255)
  projectUrl    String?            @map("project_url") @db.VarChar(255)
  isFeatured    Boolean?           @default(false) @map("is_featured")
  createdAt     DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("portfolio_items")
}

model audio_calls {
  id               BigInt       @id @default(autoincrement())
  room_id          BigInt
  instructor_id    Int
  channel_name     String       @unique @db.VarChar(100)
  status           call_status? @default(SCHEDULED)
  duration_minutes Int?         @default(0)
  started_at       DateTime?    @db.Timestamptz(6)
  ended_at         DateTime?    @db.Timestamptz(6)
  created_at       DateTime?    @default(now()) @db.Timestamptz(6)
  instructors      Instructor   @relation(fields: [instructor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chat_rooms       chat_rooms   @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model chat_messages {
  id         BigInt     @id @default(autoincrement())
  room_id    BigInt
  sender_id  BigInt
  message    String
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  chat_rooms chat_rooms @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      User       @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model chat_rooms {
  id               BigInt          @id @default(autoincrement())
  session_id       Int?
  project_id       BigInt?
  name             String          @db.VarChar(150)
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  audio_calls      audio_calls[]
  chat_messages    chat_messages[]
  projects         Project?        @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  academy_sessions AcademySession? @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model defense_projects {
  id                     Int            @id @default(autoincrement())
  title                  String         @db.VarChar(200)
  slug                   String         @unique @db.VarChar(200)
  description            String
  minimal_spec_sheet_url String?        @db.VarChar(255)
  is_available           Boolean?       @default(true)
  created_at             DateTime?      @default(now()) @db.Timestamptz(6)
  quote_requests         QuoteRequest[]
}

enum call_status {
  SCHEDULED
  ACTIVE
  ENDED
  MISSED
}

enum enrollment_status {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum payment_method {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
}

enum payment_status {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum payment_type {
  FULL
  INSTALLMENT_1
  INSTALLMENT_2
  SERVICE_DEPOSIT
}

enum portfolio_category {
  DEV_WEB
  DEV_MOBILE
  BRANDING
  ACADEMY_PROJECT
}

enum project_status {
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum quote_status {
  PENDING
  CALL_SCHEDULED
  APPROVED
  REJECTED
}

enum resource_type {
  VIDEO
  PDF
  LINK
  REPLAY_LIVE
}

enum service_category {
  DEV_WEB_MOBILE
  SOUTENANCES
  MAINTENANCE
  COMMUNITY_MANAGEMENT
  BRANDING
}

enum ticket_priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ticket_status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum user_role {
  ADMIN
  CLIENT
  STUDENT
  INSTRUCTOR
}
